// ダークテーマのベーステーマ
// このテーマが直接使われることは無い
{
	id: 'dark',

	name: 'Dark',
	author: 'WHIMSIES Ltd',
	desc: 'Default dark theme',
	kind: 'dark',

	props: {
		accent: '#4a9eff',
		accentedBg: ':alpha<0.15<@accent',
		love: '#dd2e44',
		focus: ':alpha<0.3<@accent',
		bg: '#0a0f1c',
		fg: '#c4d4e6',
		fgHighlighted: ':lighten<3<@fg',
		fgOnAccent: '#fff',
		fgOnWhite: '#1a2332',
		divider: 'rgba(74, 158, 255, 0.1)',
		indicator: '@accent',
		panel: '#151d2e',
		panelHighlight: ':lighten<3<@panel',
		panelHeaderBg: ':lighten<3<@panel',
		panelHeaderFg: '@fg',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		windowHeader: ':alpha<0.85<@panel',
		popup: ':lighten<3<@panel',
		shadow: 'rgba(10, 15, 28, 0.5)',
		header: ':alpha<0.7<@panel',
		navBg: '@panel',
		navFg: '@fg',
		navActive: '@accent',
		navIndicator: '@indicator',
		pageHeaderBg: '@bg',
		pageHeaderFg: '@fg',
		link: '#5eb3f5',
		hashtag: '#7fb8ff',
		mention: '@accent',
		mentionMe: '@mention',
		renote: '#4a9eff',
		modalBg: 'rgba(10, 15, 28, 0.6)',
		scrollbarHandle: 'rgba(74, 158, 255, 0.2)',
		scrollbarHandleHover: 'rgba(74, 158, 255, 0.4)',
		dateLabelFg: '@fg',
		infoBg: '#1e3a52',
		infoFg: '#e6f2ff',
		infoWarnBg: '#3d3420',
		infoWarnFg: '#ffbd3e',
		folderHeaderBg: 'rgba(74, 158, 255, 0.05)',
		folderHeaderHoverBg: 'rgba(74, 158, 255, 0.1)',
		buttonBg: '#1a2537',
		buttonHoverBg: '#213042',
		buttonGradateA: '@accent',
		buttonGradateB: ':hue<20<@accent',
		switchBg: 'rgba(74, 158, 255, 0.15)',
		switchOffBg: 'rgba(196, 212, 230, 0.1)',
		switchOffFg: ':alpha<0.8<@fg',
		switchOnBg: '@accentedBg',
		switchOnFg: '@accent',
		inputBorder: 'rgba(74, 158, 255, 0.1)',
		inputBorderHover: 'rgba(74, 158, 255, 0.2)',
		badge: '#4a9eff',
		messageBg: '@bg',
		success: '#4a9eff',
		error: '#ec4137',
		warn: '#ecb637',
		codeString: '#a3c7ff',
		codeNumber: '#7fb8ff',
		codeBoolean: '#b8a3ff',
		deckBg: '#0a0f1c',
		htmlThemeColor: '@bg',
	},

	codeHighlighter: {
		base: 'one-dark-pro',
	},
}
