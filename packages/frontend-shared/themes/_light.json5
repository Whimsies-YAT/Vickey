// ライトテーマのベーステーマ
// このテーマが直接使われることは無い
{
	id: 'light',

	name: 'Light',
	author: 'WHIMSIES Ltd',
	desc: 'Default light theme',
	kind: 'light',

	props: {
		accent: '#4a9eff',
		accentedBg: ':alpha<0.15<@accent',
		love: '#dd2e44',
		focus: ':alpha<0.3<@accent',
		bg: '#f8faff',
		fg: '#4a5568',
		fgHighlighted: ':darken<3<@fg',
		fgOnAccent: '#fff',
		fgOnWhite: '#2d3748',
		divider: 'rgba(74, 158, 255, 0.1)',
		indicator: '@accent',
		panel: '#f1f5ff',
		panelHighlight: ':darken<3<@panel',
		panelHeaderBg: ':lighten<3<@panel',
		panelHeaderFg: '@fg',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		windowHeader: ':alpha<0.85<@panel',
		popup: ':lighten<3<@panel',
		shadow: 'rgba(74, 158, 255, 0.15)',
		header: ':alpha<0.7<@panel',
		navBg: '@panel',
		navFg: '@fg',
		navActive: '@accent',
		navIndicator: '@indicator',
		pageHeaderBg: '@bg',
		pageHeaderFg: '@fg',
		link: '#3182ce',
		hashtag: '#4299e1',
		mention: '@accent',
		mentionMe: '@mention',
		renote: '#4a9eff',
		modalBg: 'rgba(74, 158, 255, 0.3)',
		scrollbarHandle: 'rgba(74, 158, 255, 0.2)',
		scrollbarHandleHover: 'rgba(74, 158, 255, 0.4)',
		dateLabelFg: '@fg',
		infoBg: '#e6f3ff',
		infoFg: '#4a6fa5',
		infoWarnBg: '#fff4e6',
		infoWarnFg: '#8f6e31',
		folderHeaderBg: 'rgba(74, 158, 255, 0.05)',
		folderHeaderHoverBg: 'rgba(74, 158, 255, 0.1)',
		buttonBg: '#e2ebf5',
		buttonHoverBg: '#d1e0f0',
		buttonGradateA: '@accent',
		buttonGradateB: ':hue<20<@accent',
		switchBg: 'rgba(74, 158, 255, 0.15)',
		switchOffBg: 'rgba(74, 158, 255, 0.1)',
		switchOffFg: '@panel',
		switchOnBg: '@accent',
		switchOnFg: '@fgOnAccent',
		inputBorder: 'rgba(74, 158, 255, 0.2)',
		inputBorderHover: 'rgba(74, 158, 255, 0.3)',
		badge: '#4a9eff',
		messageBg: '@bg',
		success: '#4a9eff',
		error: '#ec4137',
		warn: '#ecb637',
		codeString: '#3182ce',
		codeNumber: '#4299e1',
		codeBoolean: '#5a67d8',
		deckBg: '#eef2f7',
		htmlThemeColor: '@bg',
	},

	codeHighlighter: {
		base: 'catppuccin-latte',
	},
}
