        <domain includeSubdomains="true">your-api-domain.com</domain>
        <pin-set expiration="2026-01-01">
            <pin digest="SHA-256">your-pin-here</pin>
            <pin digest="SHA-256">backup-pin-here</pin>
        </pin-set>
    </domain-config>
    -->
</network-security-config>
